@prefix at: <https://w3id.org/cdif/provenance/activityType/> .
@prefix cdifprov: <https://w3id.org/cdif/provenance/> .
@prefix dag: <http://ddialliance.org/Specification/DDI-CDI/1.0/PROV/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

at:sampling a skos:Concept ;
    skos:definition "An activity in which a portion or part of an entity is extracted from or identified within a whole."@en ;
    skos:exactMatch dag:Sampling ;
    skos:example "The extraction of a tissue sample from a plant; The selection of participants from a registry; the acquisition of a sediment core from the deep sea;"@en ;
    skos:inScheme cdifprov:activityType ;
    skos:notation "sampling" ;
    skos:prefLabel "Sampling"@en ;
    skos:topConceptOf cdifprov:activityType .

