@prefix at: <https://w3id.org/cdif/provenance/activityType/> .
@prefix cdifprov: <https://w3id.org/cdif/provenance/> .
@prefix dag: <http://ddialliance.org/Specification/DDI-CDI/1.0/PROV/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

at:observingMeasuring a skos:Concept ;
    skos:definition "An activity during which an entity gathers data or information about another entity or itself. Measuring is observing during which reference standards or similar entities are used for the quantitative comparison of properties."@en ;
    skos:exactMatch dag:Observing_Measuring ;
    skos:example "For example, observation of features of an event; quantification of property; identification and description of qualitiative features of a phenomenon."@en ;
    skos:inScheme cdifprov:activityType ;
    skos:narrower at:dataAcquisition ;
    skos:notation "observingMeasuring" ;
    skos:prefLabel "Observing / measuring"@en ;
    skos:topConceptOf cdifprov:activityType .

