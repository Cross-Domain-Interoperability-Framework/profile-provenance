@prefix at: <https://w3id.org/cdif/provenance/activityType/> .
@prefix cdifprov: <https://w3id.org/cdif/provenance/> .
@prefix dag: <http://ddialliance.org/Specification/DDI-CDI/1.0/PROV/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

at:cataloguing a skos:Concept ;
    skos:definition "An activity during which the existence of an entity is described in a systematic list."@en ;
    skos:exactMatch dag:Cataloguing ;
    skos:example "Adding metadata about a dataset into the GBIF catalogue of assets; Cataloguing JSON-LD documents embedded in HTML pages via a sitemap.txt file;"@en ;
    skos:inScheme cdifprov:activityType ;
    skos:notation "cataloguing" ;
    skos:prefLabel "Cataloguing"@en ;
    skos:topConceptOf cdifprov:activityType .

