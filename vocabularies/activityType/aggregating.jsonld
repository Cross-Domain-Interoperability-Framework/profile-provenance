  "skos:notation": "aggregating",
  "skos:definition": {"@value": "An activity during which multiple entities are gathered together and assembled into a whole based on a defined set of criteria.", "@language": "en"},
  "skos:example": {"@value": "For example, assembling a set of records to form a combined collection of observations of a given phenemenon, often for a metastudy or to create a broader understanding of the phenomenon.", "@language": "en"},
